# Never commit real credentials. Use a secret manager in production.
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_ACCESS_TOKEN=
TTS_SHOP_ID=
# Required by signup/login and JWT authentication. Generate locally with:
#   openssl rand -hex 32
JWT_SECRET_KEY=
# Separate secret for the scheduled reconciliation endpoint. Vercel sends it
# as a bearer token when configured. Generate with: openssl rand -hex 32
CRON_SECRET=
NTFY_TOPIC=
# Alerts carry order IDs. Unauthenticated sends are refused: set a token, or
# point NTFY_SERVER at a self-hosted instance.
NTFY_TOKEN=
NTFY_SERVER=https://ntfy.sh
DRY_RUN=true

# Optional third-party Amazon marketplace-data scraper credential. Leave blank
# to use other pricing sources; this credential is separate from Shippo.
AMAZON_SCRAPER_API_KEY=

# Amazon SP-API seller-fulfilled book channel (keep live publishing disabled).
# Register/authorize the SP-API app before filling these values.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_SELLER_ID=
# Amazon.ca; use the marketplace ID from the authorized seller account.
AMAZON_SP_API_MARKETPLACE_ID=A2EUQ1WTGCTBG2

# Live mode needs BOTH of these plus every LAUNCH_* attestation below. The app
# refuses to boot -- not to mutate, to boot -- if any control is unmet.
LIVE_ENABLED=false

# Attestations. Nothing can verify these for you; set them only after doing the
# work in TikTok Shop Partner Center and confirming the controls yourself.
LAUNCH_SIGNING_VERIFIED=false
LAUNCH_SANDBOX_PASSED=false
LAUNCH_PII_CONTROLS_VERIFIED=false

# Approved "publish" reviews stay blocked until this is on. Turning it on does
# not consume an existing approval, so a blocked item executes afterwards.
PUBLISH_ENABLED=false

# Where durable order state lives. ":memory:" loses every order on restart.
ORDER_DB=orders.db

# Durable review + audit state. Approvals and the "executed once" guarantee
# live here, so ":memory:" reduces them to a single process lifetime.
REVIEW_DB=reviews.db

# docker-compose maps all five application stores to this shared DSN. Fill
# POSTGRES_PASSWORD once; Compose expands it into POSTGRES_DSN from this file.
# On Vercel, set POSTGRES_URL (or all five *_DB variables) to durable PostgreSQL.
POSTGRES_PASSWORD=
POSTGRES_DSN=postgresql://ops:${POSTGRES_PASSWORD}@db:5432/ops_core

# Shared secret used to verify order webhook signatures. Without it every
# webhook is rejected with 401, which is the intended fail-closed behaviour.
TTS_WEBHOOK_SECRET=

# Stripe subscription billing. Use a Price ID from the same Stripe mode as the
# secret key. Checkout stays unavailable until all three are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Operator credentials for /reviews. Format:
#   <sha256-of-token>:<name>:<role>[|<role>],...
# Roles: reviewer (read+decide), operator (read+execute), admin (all).
# Only digests are stored here, so this file never holds a usable token.
# Generate one with:  python -m app.api.security
# Approval is refused entirely while this is empty (503, not open access).
OPS_TOKENS=

# Custom bookshop connections (server-only JSON; defaults disabled).
# See docs/custom-bookshop/STAGING.md for separate signing keys and staging setup.
CUSTOM_SITE_CONNECTIONS=[]
