  "components": {
    "securitySchemes": {
      "signedRequest": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Ops-Signature",
        "description": "sha256=<hex HMAC-SHA256>. Sign METHOD + newline + path + newline + Unix timestamp + newline + event UUID + newline + exact body bytes. See README. Key ID maps to tenant, connection, direction and scopes."
      }
    },
    "schemas": {
      "BookSnapshot": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "publication": {
            "type": "string",
            "enum": [
              "published",
              "unpublished"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "held",
              "sold"
            ]
          },
          "quantity": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "isbn": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "edition": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "condition_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
                "description": "Exact CAD decimal amount; never a JSON float."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "CAD"
                ]
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "url",
                "alt"
              ]
            },
            "maxItems": 12
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30
          }
        },
        "required": [
          "schema_version",
          "sku",
          "revision",
          "updated_at",
          "publication",
          "availability",
          "quantity",
          "title",
          "authors",
          "format",
          "condition",
          "price",
          "images",
          "tags"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "publication": {
                  "const": "unpublished"
                }
              }
            },
            "then": {
              "properties": {
                "quantity": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "enum": [
                    "held",
                    "sold"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "quantity": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "available"
                },
                "publication": {
                  "const": "published"
                }
              }
            },
            "then": {
              "properties": {
                "quantity": {
                  "const": 1
                }
              }
            }
          }
        ],
        "description": "Complete public snapshot of one physical copy. No buyer, collector or internal shelf data. Optional fields absent/null clear old values."
      },
      "PublishReceipt": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "applied": {
            "type": "boolean"
          }
        },
        "required": [
          "sku",
          "revision",
          "applied"
        ]
      },
