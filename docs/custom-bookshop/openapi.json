{
  "openapi": "3.1.0",
  "info": {
    "title": "Ops Core and Custom Bookshop Integration",
    "version": "1.0.0-draft",
    "description": "Ops Core receiver implemented locally. Website receiver implementation and end-to-end staging verification are required before enabling payments. Operation-level servers identify the receiver. README.md and STAGING.md define signing, stock and recovery rules."
  },
  "paths": {
    "/api/ops-core/v1/books/{sku}": {
      "put": {
        "operationId": "publishBook",
        "summary": "Replace or withdraw a public book snapshot",
        "tags": [
          "Website receiver"
        ],
        "servers": [
          {
            "url": "https://website.example",
            "description": "Placeholder only; configure actual staging/production URL."
          }
        ],
        "parameters": [
          {
            "name": "X-Ops-Key-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          {
            "name": "X-Ops-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          {
            "name": "X-Ops-Event-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ],
        "security": [
          {
            "signedRequest": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable response; see README for replay and stock semantics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid signature or timestamp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Connection/scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Schema validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit; honor Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporary failure; safe to retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookSnapshot"
              }
            }
