{
  "builds": [
    {
      "src": "app/api/http.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "*/10 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/api/http.py"
    }
  ]
}
